{
  "type": "module",
  "name": "ai-studio-pc",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @ai-studio/server dev\" \"pnpm --filter @ai-studio/web dev\"",
    "test": "pnpm -r --no-bail test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @ai-studio/web e2e",
    "seed": "pnpm --filter @ai-studio/server seed",
    "reset": "pnpm --filter @ai-studio/server reset",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
