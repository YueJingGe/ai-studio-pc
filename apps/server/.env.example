# 复制为 .env 后填写；PROVIDER=mock 时无需任何 key
PORT=8787
HOST=127.0.0.1
PROVIDER=mock
# PROVIDER=dashscope 时必填（仅服务端持有，勿提交/勿外发）
# DASHSCOPE_API_KEY=
# 模型 ID：百炼控制台模型广场可查（若报 Model not exist 就改成控制台里的 ID，如 qwen-image-plus）
# DASHSCOPE_IMAGE_MODEL=qwen-image
# 外部 API 记录回放：off=直连 / record=录制 / replay=回放（CI 确定性）
CASSETTE_MODE=off
# 可选：LLM 可观测
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# DEEPSEEK_API_KEY=
